{
  "name": "labticker-platform",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "catalog:validate": "pnpm --filter @labticker/catalog validate",
    "dev:fixture-db": "tsx scripts/local-database.ts",
    "test:postgres": "tsx scripts/queue-postgres-acceptance.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@types/node": "22.19.0",
    "drizzle-orm": "0.45.4",
    "postgres": "4.0.0",
    "tsx": "4.20.6",
    "turbo": "2.5.6",
    "typescript": "5.9.3"
  }
}
