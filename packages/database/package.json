{
  "name": "@labticker/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./runtime": "./src/runtime.ts",
    "./accounts": "./src/accounts.ts",
    "./auth-policy": "./src/auth-policy.ts",
    "./source-admin": "./src/source-admin.ts",
    "./operations": "./src/operations.ts",
    "./public-catalog": "./src/public-catalog.ts",
    "./digests": "./src/digests.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "@electric-sql/pglite": "0.5.13",
    "tsx": "4.20.6"
  }
}
